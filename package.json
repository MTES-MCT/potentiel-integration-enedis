    "oclif": "^6.0.15",
    "openapi-fetch": "0.15.0",
    "openid-client": "6.1.3",
    "winston": "3.17.0",
    "zod": "4.6.7"
  },
  "bin": {
    "potentiel-integration-enedis": "./bin/run.js"
  },
  "oclif": {
    "bin": "potentiel-integration-enedis",
    "commands": "./dist/commands",
    "dirname": "potentiel-integration-enedis",
    "topicSeparator": " "
  },
  "engines": {
    "node": "^26.13.0"
  },
