  "bugs": {
    "url": "https://github.com/MTES-MCT/potentiel/issues"
  },
  "homepage": "https://potentiel.beta.gouv.fr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MTES-MCT/potentiel.git"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@tsconfig/node26": "26.0.2",
    "@types/node": "26.6.6",
    "lefthook": "2.2.2",
    "openapi-typescript": "7.13.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1045.0",
    "@json2csv/plainjs": "7.0.6",
