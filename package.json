    "format": "npx @biomejs/biome format --write ./src",
    "start:import": "./bin/run.js import",
    "start:export": "./bin/run.js export",
    "dev:import": "./bin/dev.js import",
    "dev:export": "./bin/dev.js export"
  },
  "keywords": [],
  "author": "L'équipe Potentiel <team@potentiel.beta.gouv.fr> (https://potentiel.beta.gouv.fr/)",
